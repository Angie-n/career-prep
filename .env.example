# Copy secrets to `.env.local` (never commit real secrets).
# Shared defaults live in committed `.env` (e.g. DEV_SERVER_PORT).

# Dev server port — Vite uses this; Google OAuth origin must match:
#   http://localhost:<DEV_SERVER_PORT>
DEV_SERVER_PORT=5188

# Google Cloud → Credentials → OAuth 2.0 Client IDs → Web client
# Authorized JavaScript origins:
#   - http://localhost:<DEV_SERVER_PORT>   (from DEV_SERVER_PORT above)
#   - https://<your-worker>.workers.dev    (after first deploy)
VITE_GOOGLE_CLIENT_ID=

# Optional local Wrangler (prefer `wrangler login` instead of a token on your laptop).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
